VITE_MAPBOX_KEY=your_mapbox_public_key_here

# Catalog/API origin. Paths in the app include /api/catalog/...
# Local Docker nginx: http://localhost or http://localhost/api (both normalize the same)
# Production default when unset: https://e-safari.acmad.org
BASE_URL=https://e-safari.acmad.org

# Wagtail project page slug for dynamic layer list (GET /api/catalog/ui/layers?project=...)
VITE_PROJECT_SLUG=e-safari
