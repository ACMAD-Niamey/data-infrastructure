# Afri-Met — API base URL (must include the `/api` path; no trailing slash).
# Copy to `.env` or `.env.local` and adjust for your deployment.
#
# Nginx forwarding /api to Django (browser loads SPA from same host):
# VITE_API_BASE_URL=http://localhost/api
#
# Same-origin relative path (works when SPA and API share origin):
# VITE_API_BASE_URL=/api
#
VITE_API_BASE_URL=http://localhost/api

# Optional — Mapbox public token for selectable basemaps (same pattern as e-safari-ui). Without it, Afri-Met uses MapLibre demo tiles only.
# VITE_MAPBOX_KEY=your_mapbox_public_key_here
